# Glow AI-Native Pipeline - Environment Variables
# 
# ⚠️  DO NOT PUT THIS FILE IN THE PROJECT FOLDER
#
# Create .env in the PARENT folder (outside the project):
#   C:\Users\ELITEBOOK\OneDrive\Desktop\Projects\.env
#
# Structure:
#   Projects\
#   ├── .env              ← put secrets here
#   └── glow_prd\         ← project folder (no secrets)
#
# This keeps your API keys safe from AI tools that access the project.

# ============================================================
# REQUIRED - OpenAI API Key
# ============================================================
OPENAI_API_KEY=sk-your-key-here

# ============================================================
# OPTIONAL - Azure Deployment (for CI/CD)
# ============================================================
# Service Principal credentials for Azure Container Apps deployment
# Create via: az ad sp create-for-rbac --name "glow-pipeline" --role contributor
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# ============================================================
# OPTIONAL - Docker Registry
# ============================================================
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=
DOCKER_PASSWORD=

# ============================================================
# OPTIONAL - Monitoring
# ============================================================
TELEMETRY_ENDPOINT=
TELEMETRY_TOKEN=
