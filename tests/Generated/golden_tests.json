[
  {
    "golden_test_cases": [
      {
        "name": "Valid Input - Auto Approve",
        "input": {
          "claim_id": "123e4567-e89b-12d3-a456-426614174000",
          "customer_id": "123e4567-e89b-12d3-a456-426614174001",
          "claim_amount": 200.0,
          "risk_score": 0.2,
          "damage_type": "SCREEN"
        },
        "expected_output": {
          "approval_status": "approved",
          "decision_timestamp": "ISO 8601 format",
          "reason_code": "AUTO_APPROVED"
        },
        "expected_reason_code": "AUTO_APPROVED"
      },
      {
        "name": "Invalid Input - Claim Amount Exceeds Maximum",
        "input": {
          "claim_id": "123e4567-e89b-12d3-a456-426614174002",
          "customer_id": "123e4567-e89b-12d3-a456-426614174003",
          "claim_amount": 300.0,
          "risk_score": 0.2,
          "damage_type": "SCREEN"
        },
        "expected_output": {
          "error": {
            "code": "INVALID_INPUT",
            "message": "Input validation failed"
          }
        },
        "expected_reason_code": "INVALID_INPUT"
      },
      {
        "name": "Invalid Input - Risk Score Exceeds Maximum",
